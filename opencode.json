{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "trello": {
      "type": "remote",
      "url": "https://mcp.trello.com/v1"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "trello_*": "deny"
      }
    },
    "build": {
      "permission": {
        "edit": {
          "*": "allow",
          "**/*.tscn": "ask",
          "**/*.tres": "ask",
          "project.godot": "ask",
          "export_presets.cfg": "ask"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git push*": "deny"
        },
        "trello_*": "ask"
      }
    }
  }
}
